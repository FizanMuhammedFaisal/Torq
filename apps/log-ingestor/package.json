{
	"name": "log-ingestor",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"start": "bun run src/main.ts",
		"build": "bun build src/main.ts --outdir dist --target bun",
		"format": "bun x biome format --write .",
		"lint": "bun x biome lint --write .",
		"check": "bun x biome check --write ."
	},
	"devDependencies": {
		"@types/bun": "^1.3.12"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@types/node": "^25.6.0",
		"dotenv": "^17.4.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"redis": "^5.11.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0"
	}
}
