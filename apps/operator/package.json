{
	"name": "@torq/operator",
	"version": "0.0.1",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"start": "tsx src/main.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"format": "bun x biome format --write .",
		"lint": "bun x biome lint --write .",
		"check": "bun x biome check --write .",
		"db:migrate": "bun run drizzle-kit migrate --config ./drizzle.config.ts",
		"db:generate": "bun run drizzle-kit generate --config ./drizzle.config.ts",
		"kubernetes:delete:crd": "kubectl delete crd workflowruns.torq.dev"
	},
	"type": "module",
	"dependencies": {
		"@bufbuild/protobuf": "^2.11.0",
		"@connectrpc/connect": "^2.1.1",
		"@connectrpc/connect-node": "^2.1.1",
		"@kubernetes/client-node": "^1.4.0",
		"@torq-system/grpc": "^0.0.8",
		"@types/pg": "^8.18.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.1",
		"elysia": "^1.4.27",
		"lru-cache": "^11.2.7",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"redis": "^5.11.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@types/bun": "^1.3.10",
		"@types/node": "^22.13.9",
		"bun-types": "^1.3.8",
		"tsx": "^4.21.0",
		"typescript": "^5.0.0"
	}
}
