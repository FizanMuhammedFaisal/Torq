{
	"name": "@torq/api-server",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"start": "bun run src/main.ts",
		"build": "bun build src/main.ts --outdir dist --target bun",
		"typecheck": "tsc --noEmit",
		"db:migrate": "bun run drizzle-kit migrate --config ./drizzle.config.ts",
		"db:generate": "bun run drizzle-kit generate --config ./drizzle.config.ts",
		"betterauth:migrate": "better-auth migrate --config ./src/infrastructure/auth/auth.ts",
		"betterauth:generate": "better-auth generate --config ./src/infrastructure/auth/auth.ts --output ./src/infrastructure/repository/database/schema/schema.ts",
		"format": "bun x biome format --write .",
		"lint": "bun x biome lint --write .",
		"check": "bun x biome check --write .",
		"generateMasterKey": "bun run scripts/generateMasterKey.ts"
	},
	"type": "module",
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.5.0",
		"@better-auth/telemetry": "1.5.0",
		"@connectrpc/connect": "^2.1.1",
		"@connectrpc/connect-node": "^2.1.1",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/openapi": "^1.4.14",
		"@elysiajs/opentelemetry": "^1.4.10",
		"@torq-system/grpc": "^0.0.12",
		"better-auth": "1.5.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"elysia": "^1.4.25",
		"pg": "^8.18.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.9.2",
		"tsyringe": "^4.10.0",
		"ulid": "^3.0.2",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@better-auth/cli": "1.5.0-beta.13",
		"@biomejs/biome": "^2.3.15",
		"@types/bun": "^1.3.9",
		"@types/node": "^25.3.3",
		"@types/pg": "^8.16.0",
		"bun-types": "^1.3.8",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^5.0.0"
	}
}