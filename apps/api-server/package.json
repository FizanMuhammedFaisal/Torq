{
	"name": "@torq/api-server",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"start": "bun run src/main.ts",
		"build": "bun build src/main.ts --outdir dist --target bun",
		"typecheck": "tsc --noEmit",
		"db:migrate": "bun run drizzle-kit migrate",
		"db:generate": "bun run drizzle-kit generate",
		"betterauth:migrate": "bun x @better-auth/cli@latest migrate --config ./src/infrastructure/auth/auth.ts",
		"betterauth:generate": "bun x @better-auth/cli@latest generate --config ./src/infrastructure/auth/auth.ts",
		"format": "bun x biome format --write .",
		"lint": "bun x biome lint --write .",
		"check": "bun x biome check --write ."
	},
	"type": "module",
	"dependencies": {
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/openapi": "^1.4.14",
		"@elysiajs/opentelemetry": "^1.4.10",
		"better-auth": "^1.4.18",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"elysia": "^1.4.25",
		"pg": "^8.18.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@types/bun": "^1.3.9",
		"@types/node": "^25.2.1",
		"@types/pg": "^8.16.0",
		"bun-types": "^1.3.8",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^5.0.0"
	}
}
