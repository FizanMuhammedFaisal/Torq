{
  "name": "workflow-execution-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'Run: bun run dev --filter=<app>'",
    "dev:api": "bun run --cwd apps/api-server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/api-server build && bun run --cwd apps/web build",
    "test": "bun test",
    "prepare": "husky",
    "commit": "npx cz"
  },
  "keywords": [
    "workflow",
    "kubernetes",
    "execution-engine"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/cz-commitlint": "^20.4.1",
    "@commitlint/types": "^20.4.0",
    "bun-types": "^1.3.8",
    "commitizen": "^4.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
